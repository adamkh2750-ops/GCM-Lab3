<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" prefHeight="510.0" prefWidth="570.0" spacing="13.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.gcm.LoginController">
    <padding><Insets bottom="24.0" left="30.0" right="30.0" top="24.0" /></padding>
    <Label text="GCM Login - Lab 3" style="-fx-font-size: 23; -fx-font-weight: bold;" />
    <Label fx:id="policyLabel" wrapText="true" />
    <TextField fx:id="usernameField" promptText="username (email)" />
    <PasswordField fx:id="passwordField" promptText="password" />
    <Label fx:id="errorLabel" textFill="RED" wrapText="true" minHeight="22.0" />
    <Button fx:id="loginButton" defaultButton="true" text="Login" onAction="#onLoginButtonClick" />
    <Button text="Open another login window" onAction="#onNewWindowClick" />
    <Separator />
    <Button fx:id="testButton" text="Run synchronization test (20 threads)" onAction="#onTestButtonClick" />
    <TextArea fx:id="testOutput" editable="false" wrapText="true" prefRowCount="6"
              promptText="The test uses separate state with n=10000." VBox.vgrow="ALWAYS" />
</VBox>
